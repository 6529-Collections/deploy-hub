{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/validation-request.v1.schema.json",
  "title": "Deploy Hub accepted environment validation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "acceptance_sequence",
    "accepted_at",
    "requester",
    "authority",
    "executor",
    "environment",
    "resource_key",
    "linked_deployment_request_ids",
    "snapshot_before",
    "test_tooling",
    "pack_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "deploy-hub.validation-request.v1"
    },
    "validation_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "acceptance_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "accepted_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "requester": {
      "$ref": "common.v1.schema.json#/$defs/requester"
    },
    "authority": {
      "$ref": "common.v1.schema.json#/$defs/authority"
    },
    "executor": {
      "$ref": "common.v1.schema.json#/$defs/executor"
    },
    "environment": {
      "type": "string",
      "enum": ["staging", "production"]
    },
    "resource_key": {
      "type": "string",
      "enum": ["staging:validation", "production:validation"]
    },
    "linked_deployment_request_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/uuidV4"
      }
    },
    "snapshot_before": {
      "$ref": "#/$defs/environmentSnapshot"
    },
    "test_tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha"],
      "properties": {
        "repository": {
          "const": "6529-Collections/6529seize-frontend"
        },
        "sha": {
          "$ref": "common.v1.schema.json#/$defs/gitSha"
        }
      }
    },
    "pack_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "packs", "read_only"],
      "properties": {
        "policy_id": {
          "type": "string",
          "enum": ["staging-baseline-v1", "production-baseline-v1"]
        },
        "packs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "read_only": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "environmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "environment", "observed_at", "components", "digest"],
      "properties": {
        "schema_version": {
          "const": "deploy-hub.environment-snapshot.v1"
        },
        "environment": {
          "type": "string",
          "enum": ["staging", "production"]
        },
        "observed_at": {
          "$ref": "common.v1.schema.json#/$defs/timestamp"
        },
        "components": {
          "type": "array",
          "minItems": 2,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_key",
              "repository",
              "unit",
              "source_sha",
              "runtime_identity",
              "observed_at",
              "evidence_url"
            ],
            "properties": {
              "component_key": {
                "type": "string",
                "pattern": "^(frontend:web|backend:[A-Za-z][A-Za-z0-9-]{0,99})$"
              },
              "repository": {
                "$ref": "common.v1.schema.json#/$defs/repository"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
              },
              "source_sha": {
                "$ref": "common.v1.schema.json#/$defs/gitSha"
              },
              "runtime_identity": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "value"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "http_version_sha",
                      "lambda_code_sha256",
                      "elastic_beanstalk_version",
                      "pm2_checkout_sha"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              },
              "observed_at": {
                "$ref": "common.v1.schema.json#/$defs/timestamp"
              },
              "evidence_url": {
                "type": "string",
                "format": "uri",
                "maxLength": 1000
              }
            }
          }
        },
        "digest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "staging"
          }
        },
        "required": ["environment"]
      },
      "then": {
        "properties": {
          "resource_key": {
            "const": "staging:validation"
          },
          "pack_policy": {
            "type": "object",
            "properties": {
              "policy_id": {
                "const": "staging-baseline-v1"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "resource_key": {
            "const": "production:validation"
          },
          "pack_policy": {
            "type": "object",
            "properties": {
              "policy_id": {
                "const": "production-baseline-v1"
              }
            }
          }
        }
      }
    }
  ]
}
