{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/task-event.v1.schema.json",
  "title": "Deploy Hub Codex task delivery envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "ledger_commit_sha",
    "ledger_commit_url",
    "event"
  ],
  "properties": {
    "schema_version": {
      "const": "deploy-hub.task-event.v1"
    },
    "task": {
      "$ref": "common.v1.schema.json#/$defs/taskReference"
    },
    "ledger_commit_sha": {
      "$ref": "common.v1.schema.json#/$defs/gitSha"
    },
    "ledger_commit_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    },
    "event": {
      "$ref": "ledger-event.v1.schema.json"
    }
  }
}
