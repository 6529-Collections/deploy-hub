{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/common.v1.schema.json",
  "title": "Deploy Hub common contract definitions v1",
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "githubLogin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38})(?:\\[bot\\])?$"
    },
    "repository": {
      "type": "string",
      "enum": [
        "6529-Collections/6529seize-frontend",
        "6529-Collections/6529seize-backend"
      ]
    },
    "taskReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id"],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "task_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        }
      }
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["human", "codex_task"]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "github_login": {
          "$ref": "#/$defs/githubLogin"
        },
        "profile_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "task": {
          "$ref": "#/$defs/taskReference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "codex_task"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["task"],
            "properties": {
              "task": {
                "$ref": "#/$defs/taskReference"
              }
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "authenticated_at"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["wallet_jwt", "codex_service"]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "authenticated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "profile_id": {
          "$ref": "#/$defs/uuidV4"
        },
        "github_login": {
          "$ref": "#/$defs/githubLogin"
        }
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slug"],
      "properties": {
        "kind": {
          "const": "github_app"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "installation_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "sha", "resolved_at", "pull_requests"],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "sha": {
          "$ref": "#/$defs/gitSha"
        },
        "resolved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "pull_requests": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "head_sha"],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "head_sha": {
                "$ref": "#/$defs/gitSha"
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "unit"],
      "properties": {
        "surface": {
          "type": "string",
          "enum": ["frontend", "backend"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "surface": {
                "const": "frontend"
              }
            },
            "required": ["surface"]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "web"
              }
            }
          }
        }
      ]
    },
    "workflowEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow_path", "run_id", "run_attempt", "sha", "url"],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "workflow_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^\\.github/workflows/[A-Za-z0-9._/-]+\\.ya?ml$"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "sha": {
          "$ref": "#/$defs/gitSha"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        }
      }
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "url"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ledger_commit",
            "github_deployment",
            "check_run",
            "workflow_run",
            "runtime_proof",
            "validation",
            "ci_drop",
            "release_note",
            "diagnostic"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "class", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "class": {
          "type": "string",
          "enum": [
            "validation",
            "authorization",
            "stale_source",
            "infrastructure",
            "build",
            "mutation",
            "runtime_proof",
            "product_e2e",
            "environment_drift",
            "cancel",
            "reconciliation",
            "communication"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        },
        "details_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "details_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        }
      }
    }
  }
}
