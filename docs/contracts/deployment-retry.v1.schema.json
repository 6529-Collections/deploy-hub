{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/deployment-retry.v1.schema.json",
  "title": "Deploy Hub accepted deployment retry command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "request_id",
    "previous_attempt",
    "expected_state_version",
    "terminal_event_id",
    "reason",
    "requester",
    "authority",
    "accepted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "deploy-hub.deployment-retry.v1"
    },
    "command_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "request_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "previous_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "expected_state_version": {
      "type": "integer",
      "minimum": 1
    },
    "terminal_event_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "requester": {
      "$ref": "common.v1.schema.json#/$defs/requester"
    },
    "authority": {
      "$ref": "common.v1.schema.json#/$defs/authority"
    },
    "accepted_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    }
  }
}
