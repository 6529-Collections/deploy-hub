{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/communication-outcome.v1.schema.json",
  "title": "Deploy Hub non-gating communication outcome event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "communication_id",
    "outcome_event_id",
    "request_id",
    "attempt",
    "channel",
    "state",
    "non_gating",
    "observed_at",
    "provenance",
    "provenance_digest",
    "retryable",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "deploy-hub.communication-outcome.v1"
    },
    "communication_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "outcome_event_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "previous_outcome_event_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "request_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "channel": {
      "type": "string",
      "enum": ["ci_drop", "release_note"]
    },
    "state": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending",
        "accepted",
        "duplicate",
        "ineligible",
        "enqueued",
        "skipped",
        "already_published",
        "published",
        "failed"
      ]
    },
    "non_gating": {
      "const": true
    },
    "observed_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requester",
        "authority",
        "workflow",
        "source",
        "ci_drop_contributors",
        "release_note_contributors_by_pr"
      ],
      "properties": {
        "requester": {
          "$ref": "common.v1.schema.json#/$defs/requester"
        },
        "authority": {
          "$ref": "common.v1.schema.json#/$defs/authority"
        },
        "workflow": {
          "$ref": "common.v1.schema.json#/$defs/workflowEvidence"
        },
        "source": {
          "$ref": "common.v1.schema.json#/$defs/source"
        },
        "github_deployment_id": {
          "type": "integer",
          "minimum": 1
        },
        "ci_drop_contributors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/contributorEvidence"
          }
        },
        "release_note_contributors_by_pr": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "pull_request_number", "contributors"],
            "properties": {
              "repository": {
                "$ref": "common.v1.schema.json#/$defs/repository"
              },
              "pull_request_number": {
                "type": "integer",
                "minimum": 1
              },
              "contributors": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "$ref": "#/$defs/contributorEvidence"
                }
              }
            }
          }
        }
      }
    },
    "provenance_digest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "retryable": {
      "type": "boolean"
    },
    "diagnostic": {
      "$ref": "common.v1.schema.json#/$defs/failure"
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/evidenceLink"
      }
    }
  },
  "$defs": {
    "contributorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_login", "evidence_kind", "evidence_urls"],
      "properties": {
        "github_login": {
          "$ref": "common.v1.schema.json#/$defs/githubLogin"
        },
        "evidence_kind": {
          "type": "string",
          "enum": ["exact_range", "pull_request", "commit"]
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 1000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "ci_drop"
          }
        },
        "required": ["channel"]
      },
      "then": {
        "properties": {
          "state": {
            "enum": ["not_applicable", "pending", "accepted", "duplicate", "failed"]
          }
        }
      },
      "else": {
        "properties": {
          "state": {
            "enum": ["ineligible", "pending", "enqueued", "skipped", "already_published", "published", "failed"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["diagnostic"],
        "properties": {
          "diagnostic": {
            "$ref": "common.v1.schema.json#/$defs/failure"
          }
        }
      }
    }
  ]
}
