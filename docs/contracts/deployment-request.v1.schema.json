{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/deployment-request.v1.schema.json",
  "title": "Deploy Hub accepted deployment request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "acceptance_sequence",
    "accepted_at",
    "requester",
    "authority",
    "source",
    "environment",
    "intent",
    "target",
    "resource_keys",
    "communication"
  ],
  "properties": {
    "schema_version": {
      "const": "deploy-hub.deployment-request.v1"
    },
    "request_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "acceptance_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "accepted_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "requester": {
      "$ref": "common.v1.schema.json#/$defs/requester"
    },
    "authority": {
      "$ref": "common.v1.schema.json#/$defs/authority"
    },
    "source": {
      "$ref": "common.v1.schema.json#/$defs/source"
    },
    "environment": {
      "type": "string",
      "enum": ["staging", "production"]
    },
    "intent": {
      "type": "string",
      "enum": ["deploy_staging", "deploy_production"]
    },
    "production_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "authorized_at", "authority_subject"],
      "properties": {
        "action": {
          "const": "deploy_production"
        },
        "authorized_at": {
          "$ref": "common.v1.schema.json#/$defs/timestamp"
        },
        "authority_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "target": {
      "$ref": "common.v1.schema.json#/$defs/target"
    },
    "resource_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(staging|production):(frontend:web|backend:[A-Za-z][A-Za-z0-9-]{0,99})$"
      }
    },
    "plan_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "ordinal", "total"],
      "properties": {
        "plan_id": {
          "$ref": "common.v1.schema.json#/$defs/uuidV4"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci_drop", "release_note"],
      "properties": {
        "ci_drop": {
          "const": "repository_owned"
        },
        "release_note": {
          "type": "string",
          "enum": ["not_applicable", "automatic", "explicit_opt_out"]
        },
        "release_group_id": {
          "$ref": "common.v1.schema.json#/$defs/uuidV4"
        },
        "no_pr_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "staging"
          }
        },
        "required": ["environment"]
      },
      "then": {
        "properties": {
          "intent": {
            "const": "deploy_staging"
          },
          "communication": {
            "type": "object",
            "properties": {
              "release_note": {
                "const": "not_applicable"
              }
            }
          }
        },
        "not": {
          "type": "object",
          "required": ["production_authorization"],
          "properties": {
            "production_authorization": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment": {
            "const": "production"
          }
        },
        "required": ["environment"]
      },
      "then": {
        "required": ["production_authorization"],
        "properties": {
          "production_authorization": {
            "type": "object"
          },
          "intent": {
            "const": "deploy_production"
          },
          "source": {
            "type": "object",
            "properties": {
              "ref": {
                "const": "main"
              }
            }
          },
          "communication": {
            "type": "object",
            "properties": {
              "release_note": {
                "enum": ["automatic", "explicit_opt_out"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "type": "object",
            "properties": {
              "surface": {
                "const": "frontend"
              }
            },
            "required": ["surface"]
          }
        },
        "required": ["target"]
      },
      "then": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "repository": {
                "const": "6529-Collections/6529seize-frontend"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "repository": {
                "const": "6529-Collections/6529seize-backend"
              }
            }
          }
        }
      }
    }
  ]
}
