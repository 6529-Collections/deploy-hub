{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/validation-status.v1.schema.json",
  "title": "Deploy Hub environment validation status snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "request_digest",
    "state",
    "phase",
    "state_version",
    "event_sequence",
    "attempt",
    "accepted_at",
    "updated_at",
    "queue_order_key",
    "warnings",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "deploy-hub.validation-status.v1"
    },
    "validation_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "request_digest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "state": {
      "type": "string",
      "enum": ["accepted", "waiting", "dispatched", "running", "succeeded", "failed", "cancelled", "stale"]
    },
    "phase": {
      "type": "string",
      "enum": ["accepted", "waiting_for_environment", "dispatching", "workflow_queued", "running_packs", "verifying_snapshot", "terminal"]
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "accepted_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "terminal_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "queue_order_key": {
      "type": "string",
      "pattern": "^[0-9]{20}/[0-9a-f-]{36}$",
      "maxLength": 57
    },
    "owner_validation_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "workflow": {
      "$ref": "common.v1.schema.json#/$defs/workflowEvidence"
    },
    "snapshot_after": {
      "$ref": "validation-request.v1.schema.json#/$defs/environmentSnapshot"
    },
    "failure": {
      "$ref": "common.v1.schema.json#/$defs/failure"
    },
    "cancel_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/warning"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/evidenceLink"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["succeeded", "failed", "cancelled", "stale"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["terminal_at"],
        "properties": {
          "terminal_at": {
            "$ref": "common.v1.schema.json#/$defs/timestamp"
          },
          "phase": {
            "const": "terminal"
          }
        }
      },
      "else": {
        "not": {
          "type": "object",
          "required": ["terminal_at"],
          "properties": {"terminal_at": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["failed", "stale"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["failure"],
        "properties": {
          "failure": {
            "$ref": "common.v1.schema.json#/$defs/failure"
          }
        }
      },
      "else": {
        "not": {
          "type": "object",
          "required": ["failure"],
          "properties": {"failure": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "cancelled"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["cancel_reason"],
        "properties": {
          "cancel_reason": {
            "type": "string"
          }
        }
      },
      "else": {
        "not": {
          "type": "object",
          "required": ["cancel_reason"],
          "properties": {"cancel_reason": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["snapshot_after", "workflow"],
        "properties": {
          "snapshot_after": {
            "type": "object"
          },
          "workflow": {
            "type": "object"
          }
        }
      }
    }
  ]
}
