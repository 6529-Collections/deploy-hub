{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/error.v1.schema.json",
  "title": "Deploy Hub safe API error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "message", "retryable"],
  "properties": {
    "schema_version": {
      "const": "deploy-hub.error.v1"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "retryable": {
      "type": "boolean"
    },
    "details_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 1000
    }
  }
}
