{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6529-Collections/deploy-hub/schemas/ledger-event.v1.schema.json",
  "title": "Deploy Hub authoritative ledger event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_sequence",
    "event_id",
    "subject_kind",
    "subject_id",
    "request_digest",
    "subject_sequence",
    "state_version",
    "attempt",
    "event_type",
    "occurred_at",
    "producer",
    "transition",
    "payload",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "deploy-hub.ledger-event.v1"
    },
    "ledger_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "previous_event_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "subject_kind": {
      "type": "string",
      "enum": ["deployment", "validation"]
    },
    "subject_id": {
      "$ref": "common.v1.schema.json#/$defs/uuidV4"
    },
    "request_digest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "subject_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "$ref": "#/$defs/eventType"
    },
    "occurred_at": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "transition": {
      "$ref": "#/$defs/transition"
    },
    "payload": {
      "$ref": "#/$defs/eventPayload"
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/evidenceLink"
      }
    }
  },
  "$defs": {
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "waiting",
        "dispatched",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "stale"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "accepted",
        "waiting_for_resource",
        "waiting_for_environment",
        "dispatching",
        "workflow_queued",
        "building",
        "waiting_for_mutation_claim",
        "mutating",
        "verifying_runtime",
        "waiting_for_validation",
        "validating_environment",
        "running_packs",
        "verifying_snapshot",
        "terminal"
      ]
    },
    "eventType": {
      "type": "string",
      "enum": [
        "request_accepted",
        "waiting",
        "resource_claimed",
        "validation_claimed",
        "dispatch_requested",
        "projection_linked",
        "workflow_linked",
        "workflow_started",
        "mutation_claimed",
        "mutation_started",
        "mutation_completed",
        "runtime_verified",
        "snapshot_observed",
        "validation_linked",
        "cancel_requested",
        "retry_requested",
        "communication_observed",
        "projection_warning",
        "reconciliation_required",
        "reconciled",
        "succeeded",
        "failed",
        "cancelled",
        "stale"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "deploy_hub",
            "canonical_workflow",
            "reconciler",
            "communication_pipeline"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_state", "to_state", "from_phase", "to_phase"],
      "properties": {
        "from_state": {
          "oneOf": [
            {"$ref": "#/$defs/state"},
            {"type": "null"}
          ]
        },
        "to_state": {
          "$ref": "#/$defs/state"
        },
        "from_phase": {
          "oneOf": [
            {"$ref": "#/$defs/phase"},
            {"type": "null"}
          ]
        },
        "to_phase": {
          "$ref": "#/$defs/phase"
        }
      }
    },
    "terminalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "environment_mutated",
        "runtime_verified",
        "validation_succeeded"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["succeeded", "failed", "cancelled", "stale"]
        },
        "environment_mutated": {
          "type": "boolean"
        },
        "runtime_verified": {
          "type": "boolean"
        },
        "validation_succeeded": {
          "type": "boolean"
        },
        "failure": {
          "$ref": "common.v1.schema.json#/$defs/failure"
        }
      }
    },
    "eventPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["staging", "production"]
        },
        "target": {
          "$ref": "common.v1.schema.json#/$defs/target"
        },
        "acceptance_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "order_key": {
          "type": "string",
          "pattern": "^[0-9]{20}/[0-9a-f-]{36}$",
          "maxLength": 57
        },
        "resource_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "blocked_by": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/uuidV4"
          }
        },
        "projection_kind": {
          "type": "string",
          "enum": ["github_deployment", "check_run"]
        },
        "projection_id": {
          "type": "integer",
          "minimum": 1
        },
        "projection_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        },
        "workflow": {
          "$ref": "common.v1.schema.json#/$defs/workflowEvidence"
        },
        "source_sha": {
          "$ref": "common.v1.schema.json#/$defs/gitSha"
        },
        "evidence_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000
        },
        "snapshot_role": {
          "type": "string",
          "enum": ["before", "claim_recheck", "after"]
        },
        "snapshot_digest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "validation_id": {
          "$ref": "common.v1.schema.json#/$defs/uuidV4"
        },
        "command_id": {
          "$ref": "common.v1.schema.json#/$defs/uuidV4"
        },
        "authority_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "communication_id": {
          "$ref": "common.v1.schema.json#/$defs/uuidV4"
        },
        "communication_channel": {
          "type": "string",
          "enum": ["ci_drop", "release_note"]
        },
        "communication_state": {
          "type": "string",
          "enum": [
            "not_applicable",
            "ineligible",
            "pending",
            "accepted",
            "duplicate",
            "enqueued",
            "published",
            "already_published",
            "skipped",
            "failed"
          ]
        },
        "non_gating": {
          "const": true
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "terminal_result": {
          "$ref": "#/$defs/terminalResult"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"subject_sequence": {"const": 1}},
        "required": ["subject_sequence"]
      },
      "then": {
        "not": {
          "type": "object",
          "required": ["previous_event_id"],
          "properties": {"previous_event_id": true}
        }
      },
      "else": {
        "required": ["previous_event_id"],
        "properties": {"previous_event_id": true}
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "request_accepted"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "subject_sequence": {"const": 1},
          "state_version": {"const": 1},
          "attempt": {"const": 1},
          "transition": {
            "type": "object",
            "properties": {
              "from_state": {"type": "null"},
              "to_state": {"const": "accepted"},
              "from_phase": {"type": "null"},
              "to_phase": {"const": "accepted"}
            }
          },
          "payload": {
            "type": "object",
            "properties": {
              "environment": true,
              "target": true,
              "source_sha": true,
              "acceptance_sequence": true,
              "order_key": true
            },
            "required": [
              "environment",
              "target",
              "source_sha",
              "acceptance_sequence",
              "order_key"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "waiting"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "transition": {
            "type": "object",
            "properties": {"to_state": {"const": "waiting"}}
          },
          "payload": {
            "type": "object",
            "properties": {
              "resource_keys": true,
              "blocked_by": true
            },
            "required": ["resource_keys", "blocked_by"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": ["resource_claimed", "validation_claimed", "mutation_claimed"]
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["resource_keys"],
            "properties": {"resource_keys": true}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "projection_linked"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "projection_kind": true,
              "projection_id": true,
              "projection_url": true
            },
            "required": ["projection_kind", "projection_id", "projection_url"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "workflow_linked"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["workflow"],
            "properties": {"workflow": true}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "runtime_verified"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["source_sha", "evidence_url"],
            "properties": {"source_sha": true, "evidence_url": true}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "snapshot_observed"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "subject_kind": {"const": "validation"},
          "payload": {
            "type": "object",
            "required": ["snapshot_role", "snapshot_digest"],
            "properties": {"snapshot_role": true, "snapshot_digest": true}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "validation_linked"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "subject_kind": {"const": "deployment"},
          "payload": {
            "type": "object",
            "required": ["validation_id", "snapshot_digest"],
            "properties": {"validation_id": true, "snapshot_digest": true}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {"enum": ["cancel_requested", "retry_requested"]}
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["command_id", "authority_subject", "reason"],
            "properties": {
              "command_id": true,
              "authority_subject": true,
              "reason": true
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "communication_observed"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "communication_id": true,
              "communication_channel": true,
              "communication_state": true,
              "non_gating": true
            },
            "required": [
              "communication_id",
              "communication_channel",
              "communication_state",
              "non_gating"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": ["projection_warning", "reconciliation_required", "reconciled"]
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {"code": true, "message": true}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {"enum": ["succeeded", "failed", "cancelled", "stale"]}
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "transition": {
            "type": "object",
            "properties": {"to_phase": {"const": "terminal"}}
          },
          "payload": {
            "type": "object",
            "required": ["terminal_result"],
            "properties": {"terminal_result": true}
          }
        }
      },
      "else": {
        "properties": {
          "payload": {
            "type": "object",
            "not": {
              "type": "object",
              "required": ["terminal_result"],
              "properties": {"terminal_result": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "succeeded"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "transition": {"type": "object", "properties": {"to_state": {"const": "succeeded"}}},
          "payload": {
            "type": "object",
            "properties": {
              "terminal_result": {
                "type": "object",
                "not": {
                  "type": "object",
                  "required": ["failure"],
                  "properties": {"failure": true}
                },
                "properties": {"state": {"const": "succeeded"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "failed"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "transition": {"type": "object", "properties": {"to_state": {"const": "failed"}}},
          "payload": {
            "type": "object",
            "properties": {
              "terminal_result": {
                "type": "object",
                "required": ["failure"],
                "properties": {
                  "state": {"const": "failed"},
                  "failure": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "cancelled"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "transition": {"type": "object", "properties": {"to_state": {"const": "cancelled"}}},
          "payload": {
            "type": "object",
            "properties": {
              "terminal_result": {
                "type": "object",
                "not": {
                  "type": "object",
                  "required": ["failure"],
                  "properties": {"failure": true}
                },
                "properties": {"state": {"const": "cancelled"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "stale"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "transition": {"type": "object", "properties": {"to_state": {"const": "stale"}}},
          "payload": {
            "type": "object",
            "properties": {
              "terminal_result": {
                "type": "object",
                "required": ["failure"],
                "properties": {
                  "state": {"const": "stale"},
                  "failure": true
                }
              }
            }
          }
        }
      }
    }
  ]
}
