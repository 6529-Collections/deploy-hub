{
  "name": "@6529-collections/deploy-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.17.1"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint",
    "format": "prettier --write \".github/**/*.yml\" \"*.json\" \"*.mjs\" \"ui/**/*.{html,js,css}\"",
    "format:check": "prettier --check \".github/**/*.yml\" \"*.json\" \"*.mjs\" \"ui/**/*.{html,js,css}\"",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1"
  }
}
